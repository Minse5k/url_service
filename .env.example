# 로컬 실행용 예시. 실제 값은 `.env`(git 제외)나 배포 환경 변수로만 넣는다.

# 백엔드(Render) ──────────────────────────────────────────
# Postgres 접속 주소. Render에서는 render.yaml의 fromDatabase로 자동 주입된다.
DATABASE_URL=postgres://postgres:postgres@localhost:55432/url_service
# 단축 URL 앞부분 = 공개 서비스 주소(Cloudflare). 로컬은 dx serve 주소.
BASE_URL=http://localhost:8090
# 서버가 바인딩할 주소/포트. Render는 PORT를 자동 주입한다.
IP=0.0.0.0
PORT=8080

# 테스트 ──────────────────────────────────────────────────
# 설정하면 crates/storage 의 Postgres 통합 테스트가 실행된다(없으면 건너뜀).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:55432/url_service

# Cloudflare Worker ───────────────────────────────────────
# 비밀값이 아니며 cloudflare/wrangler.toml 의 [vars] 에 둔다.
# BACKEND_URL=https://<render-service>.onrender.com
